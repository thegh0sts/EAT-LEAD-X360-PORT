+// eatlead: PlayStation buttons painted over a game's own Xbox button textures, described by a text file the game
+// ships, prompts/playstation.txt (or assets/prompts/ when run from the project folder):
+//   texture <name> <width> <height> <FNV-1a 64 of the base level, hex>
+//   draw <x0> <y0> <x1> <y1> <image|-> <fit|stretch> [clear]   ("-": clear only)
+// for 32-bit (k_8_8_8_8, ARGB) tiled textures; images are prompts/<image>.png. Which buttons to show is the game's
+// int cvar pad_prompts_active (0 Xbox, 1 PlayStation), read by native.cpp each frame.
+bool PadSheetSize(uint32_t width, uint32_t height);  // a described texture has this size
+// The described texture whose base level (tiled, width x height x 4 bytes at guest) matches, or -1.
+int FindPadSheet(const uint8_t* guest, uint32_t width, uint32_t height);
+// Its base level as RGBA8 rows with the PlayStation buttons painted on; empty on failure.
+std::vector<uint8_t> BuildPadSheet(int sheet, const uint8_t* guest);
+
 }  // namespace bots::prompts
