+// --- eatlead: PlayStation buttons over the game's own Xbox button textures (prompts/playstation.txt) ---
+
+namespace {
+
+struct PadDraw {
+  int x0, y0, x1, y1;
+  std::string image;
+  bool stretch = false, clear = false;
+};
+
+struct PadSheet {
+  std::string name;
+  uint32_t width = 0, height = 0;
+  uint64_t hash = 0;
+  std::vector<PadDraw> draws;
+};
+
+struct PadImage {
+  int width = 0, height = 0;
+  std::vector<uint8_t> rgba;
+};
+
+struct PadConfig {
+  std::vector<PadSheet> sheets;
+  std::unordered_map<std::string, PadImage> images;
+};
+
+const PadConfig& Config() {
+  static const PadConfig config = [] {
+    PadConfig c;
+    for (const char* dir : {"prompts", "assets/prompts"}) {
+      std::ifstream file(std::filesystem::path(dir) / "playstation.txt");
+      if (!file) continue;
+      std::string line;
+      while (std::getline(file, line)) {
+        std::istringstream in(line);
+        std::string word;
+        if (!(in >> word) || word[0] == '#') continue;
+        if (word == "texture") {
+          PadSheet sheet;
+          std::string hash;
+          if (in >> sheet.name >> sheet.width >> sheet.height >> hash) {
+            sheet.hash = std::strtoull(hash.c_str(), nullptr, 16);
+            c.sheets.push_back(std::move(sheet));
+          }
+        } else if (word == "draw" && !c.sheets.empty()) {
+          PadDraw draw;
+          std::string mode, extra;
+          if (!(in >> draw.x0 >> draw.y0 >> draw.x1 >> draw.y1 >> draw.image >> mode)) continue;
+          draw.stretch = mode == "stretch";
+          while (in >> extra) draw.clear |= extra == "clear";
+          c.sheets.back().draws.push_back(draw);
+          if (draw.image == "-") {
+            c.images.emplace(draw.image, PadImage{});  // clear only
+          } else if (!c.images.count(draw.image)) {
+            std::ifstream png(std::filesystem::path(dir) / (draw.image + ".png"), std::ios::binary);
+            const std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(png)), std::istreambuf_iterator<char>());
+            PadImage image;
+            int n = 0;
+            if (stbi_uc* rgba = bytes.empty() ? nullptr
+                                              : stbi_load_from_memory(bytes.data(), int(bytes.size()), &image.width,
+                                                                      &image.height, &n, 4)) {
+              // Cropped to what isn't transparent, so "fit" sizes the button itself, not its margins.
+              int x0 = image.width, y0 = image.height, x1 = -1, y1 = -1;
+              for (int y = 0; y < image.height; ++y)
+                for (int x = 0; x < image.width; ++x)
+                  if (rgba[(size_t(y) * image.width + x) * 4 + 3] > 8)
+                    x0 = std::min(x0, x), y0 = std::min(y0, y), x1 = std::max(x1, x), y1 = std::max(y1, y);
+              if (x1 >= x0) {
+                const int w = x1 - x0 + 1, h = y1 - y0 + 1;
+                image.rgba.resize(size_t(w) * h * 4);
+                for (int y = 0; y < h; ++y)
+                  std::memcpy(&image.rgba[size_t(y) * w * 4], &rgba[(size_t(y + y0) * image.width + x0) * 4],
+                              size_t(w) * 4);
+                image.width = w, image.height = h;
+              }
+              stbi_image_free(rgba);
+            } else {
+              REXLOG_WARN("pad prompts: {}/{}.png didn't load", dir, draw.image);
+            }
+            c.images.emplace(draw.image, std::move(image));
+          }
+        }
+      }
+      REXLOG_INFO("pad prompts: {}/playstation.txt: {} textures, {} images", dir, c.sheets.size(), c.images.size());
+      break;
+    }
+    return c;
+  }();
+  return config;
+}
+
+// Byte offset of texel (x, y) in a tiled 2D texture, pitch in texels (a multiple of 32), 2^log2_bpp bytes a texel.
+uint32_t TiledOffset(uint32_t x, uint32_t y, uint32_t pitch, uint32_t log2_bpp) {
+  const uint32_t macro = ((x >> 5) + (y >> 5) * (pitch >> 5)) << (log2_bpp + 7);
+  const uint32_t micro = ((x & 7) + ((y & 0xE) << 2)) << log2_bpp;
+  const uint32_t offset = macro + ((micro & ~0xFu) << 1) + (micro & 0xF) + ((y & 1) << 4);
+  return ((offset & ~0x1FFu) << 3) + ((y & 16) << 7) + ((offset & 0x1C0) << 2) +
+         (((((y & 8) >> 2) + (x >> 3)) & 3) << 6) + (offset & 0x3F);
+}
+
+std::vector<uint8_t> Untile(const uint8_t* guest, uint32_t width, uint32_t height) {
+  std::vector<uint8_t> rgba(size_t(width) * height * 4);
+  const uint32_t pitch = (width + 31) & ~31u;
+  for (uint32_t y = 0; y < height; ++y) {
+    for (uint32_t x = 0; x < width; ++x) {
+      const uint8_t* p = guest + TiledOffset(x, y, pitch, 2);  // A R G B
+      uint8_t* q = &rgba[(size_t(y) * width + x) * 4];
+      q[0] = p[1], q[1] = p[2], q[2] = p[3], q[3] = p[0];
+    }
+  }
+  return rgba;
+}
+
+// image over out's rect (x0, y0)-(x1, y1): stretched to it, or fitted (aspect kept, centred). Each pixel averages
+// 4x4 samples of the image, premultiplied.
+void Paint(const PadImage& image, const PadDraw& d, uint32_t width, uint32_t height, std::vector<uint8_t>& out) {
+  float w = float(d.x1 - d.x0), h = float(d.y1 - d.y0), ox = float(d.x0), oy = float(d.y0);
+  if (!d.stretch && image.width > 0 && image.height > 0) {
+    const float k = std::min(w / image.width, h / image.height);
+    ox += (w - image.width * k) * 0.5f, oy += (h - image.height * k) * 0.5f;
+    w = image.width * k, h = image.height * k;
+  }
+  if (d.clear) {
+    for (int y = std::max(d.y0, 0); y < std::min(d.y1, int(height)); ++y)
+      for (int x = std::max(d.x0, 0); x < std::min(d.x1, int(width)); ++x) {
+        uint8_t* q = &out[(size_t(y) * width + x) * 4];
+        q[0] = q[1] = q[2] = 255, q[3] = 0;  // the sheets' transparent texels are white
+      }
+  }
+  if (image.rgba.empty() || w <= 0 || h <= 0) return;
+  for (int y = std::max(int(std::floor(oy)), 0); y < std::min(int(std::ceil(oy + h)), int(height)); ++y) {
+    for (int x = std::max(int(std::floor(ox)), 0); x < std::min(int(std::ceil(ox + w)), int(width)); ++x) {
+      float r = 0, g = 0, b = 0, a = 0;
+      for (int sy = 0; sy < 4; ++sy) {
+        for (int sx = 0; sx < 4; ++sx) {
+          const float u = (x + (sx + 0.5f) / 4 - ox) / w, v = (y + (sy + 0.5f) / 4 - oy) / h;
+          if (u < 0 || v < 0 || u >= 1 || v >= 1) continue;
+          const uint8_t* p = &image.rgba[(size_t(int(v * image.height)) * image.width + int(u * image.width)) * 4];
+          const float pa = p[3] / 255.0f;
+          r += p[0] * pa, g += p[1] * pa, b += p[2] * pa, a += pa;
+        }
+      }
+      if (a <= 0) continue;
+      uint8_t* q = &out[(size_t(y) * width + x) * 4];
+      const float sa = a / 16.0f, da = q[3] / 255.0f * (1 - sa), oa = sa + da;
+      for (int c = 0; c < 3; ++c) {
+        const float src = (c == 0 ? r : c == 1 ? g : b) / 16.0f;  // premultiplied
+        q[c] = uint8_t(std::clamp((src + q[c] * da) / std::max(oa, 1e-6f), 0.0f, 255.0f) + 0.5f);
+      }
+      q[3] = uint8_t(std::clamp(oa * 255.0f + 0.5f, 0.0f, 255.0f));
+    }
+  }
+}
+
+}  // namespace
+
+bool PadSheetSize(uint32_t width, uint32_t height) {
+  for (const PadSheet& s : Config().sheets)
+    if (s.width == width && s.height == height) return true;
+  return false;
+}
+
+int FindPadSheet(const uint8_t* guest, uint32_t width, uint32_t height) {
+  const auto& sheets = Config().sheets;
+  const uint64_t hash = Hash(guest, size_t(width) * height * 4);
+  for (size_t i = 0; i < sheets.size(); ++i)
+    if (sheets[i].width == width && sheets[i].height == height && sheets[i].hash == hash) return int(i);
+  static int logged = 0;  // what didn't match, for a new sheet or another release of the game
+  if (logged < 16) {
+    ++logged;
+    REXLOG_INFO("pad prompts: a {}x{} ARGB texture, hash {:016X}, isn't described", width, height, hash);
+  }
+  return -1;
+}
+
+std::vector<uint8_t> BuildPadSheet(int sheet, const uint8_t* guest) {
+  const auto& config = Config();
+  if (sheet < 0 || size_t(sheet) >= config.sheets.size()) return {};
+  const PadSheet& s = config.sheets[sheet];
+  std::vector<uint8_t> out = Untile(guest, s.width, s.height);
+  for (const PadDraw& d : s.draws) Paint(config.images.at(d.image), d, s.width, s.height, out);
+  static std::unordered_map<int, bool> logged;
+  if (!logged[sheet]) {
+    logged[sheet] = true;
+    REXLOG_INFO("pad prompts: {} shows PlayStation buttons ({} drawn)", s.name, s.draws.size());
+  }
+  return out;
+}
+
 }  // namespace bots::prompts
