+bool Renderer::LoadRgbaTexture(GuestTexture& texture, uint32_t address, uint32_t bytes,
+                               const std::vector<uint8_t>& pixels, uint32_t width, uint32_t height) {
+  if (!CreateImage(texture.image, VK_FORMAT_R8G8B8A8_UNORM, width, height, false, VK_IMAGE_VIEW_TYPE_2D_ARRAY, false, 1,
+                   1)) {
+    texture.image = {};
+    return false;
+  }
+  texture.host_format_swizzle = xe::XE_GPU_TEXTURE_SWIZZLE_RGBA;
+  texture.ranges[0] = {address, address + bytes};  // the game replacing it reloads the slot
+  if (tracker_) tracker_->Request(address, bytes);
+  VkDeviceSize offset;
+  uint8_t* staging = Upload(pixels.size(), 16, offset);
+  if (!staging) {
+    Flush();
+    BeginCommands(kGpuTexture);
+    staging = Upload(pixels.size(), 16, offset);
+    if (!staging) return false;
+  }
+  std::memcpy(staging, pixels.data(), pixels.size());
+  VkBufferImageCopy region{};
+  region.bufferOffset = offset;
+  region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.imageExtent = {width, height, 1};
+  vk_.vkCmdCopyBufferToImage(cmd_, ring_.buffer, texture.image.image, VK_IMAGE_LAYOUT_GENERAL, 1, &region);
+  Barrier();
+  ++stats_.textures;
+  return true;
+}
