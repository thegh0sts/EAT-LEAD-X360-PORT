+void Renderer::SetHint(float alpha, float x, float y, uint32_t width, uint32_t height, const uint32_t* rgba) {
+  if (!rgba || width == 0 || height == 0 || width > kHintMaxWidth || height > kHintMaxHeight || width * height > kHintTexels) {
+    hint_alpha_ = 0.0f;
+    return;
+  }
+  hint_alpha_ = alpha;
+  hint_x_ = x;
+  hint_y_ = y;
+  hint_width_ = width;
+  hint_height_ = height;
+  std::memcpy(hint_image_, rgba, size_t(width) * height * 4);
+}
