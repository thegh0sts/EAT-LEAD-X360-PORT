+// Menu hint (eatlead): a small image the game asks for (--menu_hint, e.g. "B Quit" on the main menu), drawn over the
+// picture at hint_at in 1080p pixels of a 16:9 frame, scaled with the output and filtered bilinearly; hint.x fades it.
+vec4 HintTexel(ivec2 t) {
+  ivec2 size = ivec2(hint.yz);
+  if (t.x < 0 || t.y < 0 || t.x >= size.x || t.y >= size.y) return vec4(0.0);
+  uint i = uint(t.y * size.x + t.x);
+  return unpackUnorm4x8(hint_image[i >> 2u][i & 3u]);
+}
+
+vec4 Hint(vec2 pixel, vec4 color) {
+  float a = uintBitsToFloat(hint.x);
+  vec2 out_size = vec2(textureSize(source, 0).xy) / render_scale.xx;
+  float s = out_size.y / 1080.0;
+  vec2 origin = vec2((out_size.x - 1920.0 * s) * 0.5, 0.0);  // a wider output centres the 16:9 frame
+  vec2 p = (pixel - origin) / s - hint_at.xy;  // hint image pixels
+  if (p.x < -1.0 || p.y < -1.0 || p.x > float(hint.y) + 1.0 || p.y > float(hint.z) + 1.0) return color;
+  vec2 q = p - 0.5;
+  ivec2 t = ivec2(floor(q));
+  vec2 f = q - vec2(t);
+  vec4 c00 = HintTexel(t), c10 = HintTexel(t + ivec2(1, 0)), c01 = HintTexel(t + ivec2(0, 1)),
+       c11 = HintTexel(t + ivec2(1, 1));
+  // premultiplied, so transparent texels don't darken the edges
+  vec4 p00 = vec4(c00.rgb * c00.a, c00.a), p10 = vec4(c10.rgb * c10.a, c10.a), p01 = vec4(c01.rgb * c01.a, c01.a),
+       p11 = vec4(c11.rgb * c11.a, c11.a);
+  vec4 m = mix(mix(p00, p10, f.x), mix(p01, p11, f.x), f.y);
+  return vec4(color.rgb * (1.0 - m.a * a) + m.rgb * a, color.a);
+}
