+  // eatlead: a menu hint the game asks for through its cvars: --menu_hint (an int, read each frame; the game changes
+  // it while running, and an int can be read while it's written) picks image N (from 1) of --menu_hint_images, a
+  // comma-separated list of names fixed at start, each hints/<name>.png (or assets/hints/ when run from the project
+  // folder); 0 hides it. Drawn at --menu_hint_pos "x,y" (1080p pixels of a 16:9 frame) by the present pass
+  // (Renderer::SetHint), fading in and out over 0.15 s.
+  void UpdateHint() {
+    static const std::string images = rex::cvar::Query<std::string>("menu_hint_images");
+    if (images.empty()) return;
+    const int32_t index = rex::cvar::Query<int32_t>("menu_hint");
+    std::string name;
+    if (index > 0) {
+      size_t at = 0;
+      for (int32_t i = 1; i < index && at != std::string::npos; ++i) {
+        at = images.find(',', at);
+        if (at != std::string::npos) ++at;
+      }
+      if (at != std::string::npos) name = images.substr(at, images.find(',', at) - at);
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const float dt = hint_last_.time_since_epoch().count() ? std::chrono::duration<float>(now - hint_last_).count() : 0.0f;
+    hint_last_ = now;
+    if (!name.empty() && name != hint_name_) {
+      hint_name_ = name;
+      hint_loaded_ = LoadHint(name);
+      static const std::string pos = rex::cvar::Query<std::string>("menu_hint_pos");
+      hint_x_ = 0.0f;
+      hint_y_ = 0.0f;
+      std::sscanf(pos.c_str(), "%f,%f", &hint_x_, &hint_y_);
+    }
+    const float target = !name.empty() && hint_loaded_ ? 1.0f : 0.0f;
+    hint_alpha_ = target > hint_alpha_ ? std::min(target, hint_alpha_ + dt / 0.15f)
+                                       : std::max(target, hint_alpha_ - dt / 0.15f);
+    if (hint_alpha_ <= 0.0f && !hint_showing_) return;
+    hint_showing_ = hint_alpha_ > 0.0f;
+    renderer_->SetHint(hint_alpha_, hint_x_, hint_y_, hint_width_, hint_height_, hint_pixels_.data());
+  }
+  bool LoadHint(const std::string& name) {
+    for (const char* dir : {"hints", "assets/hints"}) {
+      std::ifstream file(std::filesystem::path(dir) / (name + ".png"), std::ios::binary);
+      const std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+      if (bytes.empty()) continue;
+      int w = 0, h = 0, n = 0;
+      stbi_uc* rgba = stbi_load_from_memory(bytes.data(), int(bytes.size()), &w, &h, &n, 4);
+      if (!rgba) continue;
+      const bool fits = w > 0 && h > 0 && w <= 160 && h <= 48;
+      if (fits) {
+        hint_width_ = uint32_t(w);
+        hint_height_ = uint32_t(h);
+        hint_pixels_.assign(size_t(w) * h, 0);
+        std::memcpy(hint_pixels_.data(), rgba, size_t(w) * h * 4);
+      }
+      stbi_image_free(rgba);
+      std::fprintf(stderr, "gfx native: menu hint %s/%s.png %dx%d%s\n", dir, name.c_str(), w, h,
+                   fits ? "" : " (too big: at most 160x48)");
+      if (fits) return true;
+    }
+    return false;
+  }
+  std::string hint_name_;
+  bool hint_loaded_ = false, hint_showing_ = false;
+  float hint_alpha_ = 0.0f, hint_x_ = 0.0f, hint_y_ = 0.0f;
+  uint32_t hint_width_ = 0, hint_height_ = 0;
+  std::vector<uint32_t> hint_pixels_;
+  std::chrono::steady_clock::time_point hint_last_{};
+
   std::mutex toast_mutex_;
